@torch.inference_mode()
def predict_probabilities(seed, features):
    item = ensemble_models[seed]

    head = item["head"]
    feature_mean = item["mean"]
    feature_std = item["std"]

    # Standardize using this checkpoint's statistics
    z = features.to(DEVICE)
    z = (z - feature_mean) / feature_std

    logits = head(z)
    return torch.softmax(logits, dim=1).cpu()


