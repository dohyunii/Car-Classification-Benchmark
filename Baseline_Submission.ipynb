acc_flip = print_metrics("Flip only", pred_flip)
acc_tta = print_metrics("Flip TTA", pred_tta)

print(
    "Changed predictions:",
    np.count_nonzero(pred_orig != pred_tta)
)

print(
    "Original correct:",
    np.sum(pred_orig == y_true)
)
print(
    "TTA correct:",
    np.sum(pred_tta == y_true)
)

if not np.isclose(acc_orig, 0.98):
    print(
        "WARNING: Original accuracy did not reproduce "
        "the F0 seed-2026 result. Verify checkpoint, "
        "backbone, and validation preprocessing."
    )

