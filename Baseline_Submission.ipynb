h0_test_loader = DataLoader(
    test_ds,
    batch_size=TTA_BATCH_SIZE,
    shuffle=False,
    num_workers=0
)


@torch.inference_mode()
def predict_original_and_flip(loader):
    backbone.eval()
    head.eval()

    original_probs = []
    flipped_probs = []

    for batch in tqdm(loader, desc="TTA inference"):
        images = (
            batch[0]
            if isinstance(batch, (list, tuple))
            else batch
        )

        images = images.to(DEVICE)
        n = images.size(0)

        # Horizontal flip along image width
        flipped = torch.flip(images, dims=[-1])

        # Process original and flipped images together
        combined = torch.cat(
            [images, flipped],
            dim=0
        )

        features = backbone(combined).float()

        # Apply F0 training-set normalization
        features = (
            features - feature_mean
        ) / feature_std

        logits = head(features)
        probs = torch.softmax(logits, dim=1)

        original_probs.append(probs[:n].cpu())
        flipped_probs.append(probs[n:].cpu())

    return (
        torch.cat(original_probs, dim=0),
        torch.cat(flipped_probs, dim=0)
    )

