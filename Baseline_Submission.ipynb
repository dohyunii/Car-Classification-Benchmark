## 7. Train the provided **linear** classification head

This is the baseline students should improve. Feel free to test an MLP, regularization, different DINO token pooling, or other allowed techniques while keeping the backbone frozen.
HEAD_CONFIGS = {
    "E0_linear": {
        "hidden_dim": None,
        "use_bn": False,
        "dropout": 0.0
    },
    "E1_mlp": {
        "hidden_dim": 128,
        "use_bn": False,
        "dropout": 0.0
    },
    "E2_mlp_bn": {
        "hidden_dim": 128,
        "use_bn": True,
        "dropout": 0.0
    },
    "E3_mlp_bn_drop01": {
        "hidden_dim": 128,
        "use_bn": True,
        "dropout": 0.1
    },
    "E4_mlp_bn_drop03": {
        "hidden_dim": 128,
        "use_bn": True,
        "dropout": 0.3
    }
}


def build_head(experiment, input_dim, num_classes):
    cfg = HEAD_CONFIGS[experiment]

    if cfg["hidden_dim"] is None:
        return nn.Linear(input_dim, num_classes)

    layers = [
        nn.Linear(input_dim, cfg["hidden_dim"])
    ]

    if cfg["use_bn"]:
        layers.append(
            nn.BatchNorm1d(cfg["hidden_dim"])
        )

    layers.append(nn.ReLU())

    if cfg["dropout"] > 0:
        layers.append(nn.Dropout(cfg["dropout"]))

    layers.append(
        nn.Linear(cfg["hidden_dim"], num_classes)
    )

    return nn.Sequential(*layers)

