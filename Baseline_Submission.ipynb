# H0: Original + horizontal-flip inference
from torch.utils.data import DataLoader

TTA_BATCH_SIZE = 16

h0_val_loader = DataLoader(
    val_ds,
    batch_size=TTA_BATCH_SIZE,
    shuffle=False,
    num_workers=0
